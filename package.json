{
  "name": "sz-io-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Dev tooling for the static portfolio site. Nothing here ships to the site.",
  "scripts": {
    "lint:html": "html-validate index.html 404.html",
    "lint:json": "ajv validate --spec=draft7 -s assets/data/projects.schema.json -d assets/data/projects.json",
    "contrast": "node tools/contrast-check.mjs",
    "check": "npm run lint:html && npm run lint:json && npm run contrast",
    "test:browser": "node tools/browser-test.mjs"
  },
  "devDependencies": {
    "ajv-cli": "5.0.0",
    "html-validate": "11.19.0"
  },
  "overrides": {
    "fast-json-patch": "3.1.1"
  }
}
